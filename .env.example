# Copy this to .env and change the password
# obviously never commit .env 

# user and pass docker create
POSTGRES_USER=geoint
POSTGRES_PASSWORD=change-me-bro
# Host port; change this and DATABASE_URL together if 5432 is already in use
POSTGRES_PORT=5432

# for keycloak later on
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-bruv

# Used by the python back end
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

#   USER/PASSWORD -> same as POSTGRES_USER / POSTGRES_PASSWORD above
#   HOST:PORT     -> localhost:5432 (the Docker database local computer)
#   DATABASE      -> geoapp (the app's database)

# PLEEEEASE avoid @ : / in passwords they break the address
DATABASE_URL=postgresql+psycopg://geoint:change-me@localhost:5432/geoapp

# folder where snapshot and upload images files are saved
IMAGE_DIR=data/images

# FastAPI application settings (optional; defaults shown)
BACKEND_APP_NAME="GEOINT Multimodal"
# JSON array of browser origins allowed to call the future API
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
